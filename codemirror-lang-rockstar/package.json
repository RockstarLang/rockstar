{
  "name": "@rockstarlang/codemirror-lang-rockstar",
  "version": "2.0.36",
  "description": "Rockstar language support for CodeMirror",
  "keywords": [
    "codemirror",
    "codemirror6",
    "lezer",
    "rockstar",
    "syntax-highlighting",
    "language"
  ],
  "homepage": "https://codewithrockstar.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RockstarLang/rockstar.git",
    "directory": "codemirror-lang-rockstar"
  },
  "bugs": "https://github.com/RockstarLang/rockstar/issues",
  "author": "Dylan Beattie <dylan@dylanbeattie.net>",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "watch": {
    "prepare": {
      "patterns": [
        "src"
      ],
      "ignore": [
        "src/grammars/kitchen-sink.js",
        "src/grammars/kitchen-sink.terms.js",
        "src/grammars/rockstar.js",
        "src/grammars/rockstar.terms.js"
      ],
      "extensions": "js,grammar,ts,mjs"
    }
  },
  "scripts": {
    "build": "npm run build-grammar && rollup -c && npm run build-lib",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "prepare": "npm run build",
    "watch": "npm-watch",
    "build-grammar": "lezer-generator src/grammars/rockstar.grammar -o src/grammars/rockstar && lezer-generator src/grammars/kitchen-sink.grammar -o src/grammars/kitchen-sink",
    "build-lib": "rollup -c rollup.lib.config.js",
    "prepublishOnly": "npm test"
  },
  "wallaby": {
    "env": {
      "params": {
        "runner": "--experimental-vm-modules"
      }
    }
  },
  "dependencies": {
    "@codemirror/language": "^6.10.2",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.26.0",
    "@lezer/common": "^1.2.0",
    "@lezer/highlight": "^1.2.0",
    "@lezer/lr": "^1.4.2"
  },
  "devDependencies": {
    "@lezer/generator": "^1.7.1",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "rollup": "^4.19.1",
    "rollup-plugin-dts": "^6.1.1",
    "tslib": "^2.9.1",
    "typescript": "^5.5.4",
    "codemirror": "^6.0.1",
    "npm-watch": "^0.13.0"
  }
}
